# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/dailytick
# O para MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dailytick

# Server Port
PORT=3000

# Session Secret (cambia esto en producción)
SESSION_SECRET=dailytick-secret-key-change-in-production

# JWT Secret (cambia esto en producción)
JWT_SECRET=dailytick-jwt-secret-change-in-production

# Environment
NODE_ENV=development
